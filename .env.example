# Copy to .env and fill in. Placeholders only; never commit .env.
# Judges' sample mode needs none of this: docker compose --profile sample up --build app-sample ui-sample

# Model provider: Meterless Nightshift (the NVIDIA key lives inside Nightshift, not here)
LLM_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-runtime-token-from-nightshift-console
METERLESS_MODEL=meterless/auto

# Zetaris (local platform, REST API)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_ORG_ID=1

# Project Postgres sources (pick any values)
PG_READER_USER=zetaris_reader
PG_READER_PASSWORD=change-me
PG_ADMIN_PASSWORD=change-me

# Runtime
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
LOG_DIR=logs
STATE_DIR=state
DECISIONS_FILE=data/feedback/decisions.jsonl
SCAN_LIMIT=5
SCAN_BUDGET_S=300
